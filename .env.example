# Optional: every value below is the built-in default, so no .env is needed for local dev.
# The server reads process environment variables only (no dotenv dependency).
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgres://wayfarer:wayfarer@localhost:5432/wayfarer
TEST_DATABASE_URL=postgres://wayfarer:wayfarer@localhost:5432/wayfarer_test
# Host port for the Postgres container (docker-compose.yml)
WAYFARER_DB_PORT=5432
